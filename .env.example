# para-files settings. Copy to ~/.config/para-files/.env (or $PARA_FILES_CONFIG_DIR/.env).
# Environment variables win over this file; every line except the PARA root is optional.

# Folder that holds 0_Inbox and the 1_ to 4_ buckets (required)
PARA_FILES_PARA_ROOT=~/PARA

# Optional cloud model fallback (OpenRouter, zero data retention). Without a key it is never asked.
# OPENROUTER_API_KEY=sk-or-...
# PARA_FILES_FALLBACK_ENABLED=true
# PARA_FILES_FALLBACK_MODEL=google/gemini-3.8-flash
# PARA_FILES_FALLBACK_BACKUP_MODEL=anthropic/claude-sonnet-5.5

# Bands and calibration
# PARA_FILES_CALIBRATION_MIN=100
# PARA_FILES_ISSUERS_GREEN=0.9
# PARA_FILES_FALLBACK_GREEN=0.9
# PARA_FILES_FALLBACK_RED=0.3

# Reading and speed
# PARA_FILES_PREVIEW_CHARS=2000
# PARA_FILES_MAX_WORKERS=4

# Where the cache and the run journals live
# PARA_FILES_CACHE_PATH=~/.cache/para-files/cache.sqlite
# PARA_FILES_STATE_DIR=~/.local/state/para-files
